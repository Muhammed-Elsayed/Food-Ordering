{
  "name": "food-ordering",
  "version": "1.0.0",
  "description": "Cool food ordering application",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch prisma --watch tsconfig.json --ignore src/db/generated --ext ts,json,prisma --exec \"npm run build && node dist/index.js\"",
    "build": "npm run db:generate && tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test tests/*.test.cjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check": "npm run build && node dist/db/check.js",
    "test:db": "npm run build && RUN_DB_TESTS=1 node --test tests/database.test.cjs",
    "docs:api": "node scripts/generate-api-docs.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammed-Elsayed/Food-Ordering.git"
  },
  "author": "Mohamed-Elsayed",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Muhammed-Elsayed/Food-Ordering/issues"
  },
  "homepage": "https://github.com/Muhammed-Elsayed/Food-Ordering#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "~8.7.1",
    "googleapis": "^185.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
