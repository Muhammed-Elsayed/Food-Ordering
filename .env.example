PORT=3000

# PostgreSQL connection. Use a dedicated role that owns only this database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/food_ordering?schema=public

# Google OAuth client of type "Web application".
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Must be listed under the client's Authorized redirect URIs.
OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Long random values, for example the output of:
# node -e "console.log(require('node:crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET_KEY=
OTP_SECRET_KEY=
